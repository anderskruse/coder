{
  "name": "kk-code-vsc",
  "displayName": "KK-Code VSC",
  "description": "Opens and closes diff views for KK-Code CLI without stealing focus",
  "version": "1.0.0",
  "publisher": "kkcode",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kkcode.openDiff",
        "title": "KKCode: Open Diff"
      },
      {
        "command": "kkcode.closeDiff",
        "title": "KKCode: Close Diff"
      }
    ]
  },
  "scripts": {},
  "devDependencies": {}
}
